generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Tribute {
  id              String   @id @default(cuid())
  authorName      String
  relationship    String // "Family" | "Staff" | "Parent" | "Friend" | "Student" | "Other"
  rawMessage      String
  polishedMessage String?
  poeticSummary   String?
  category        String   @default("The Visionary") // Educator | Mother | Visionary | Friend
  audioUrl        String?
  isApproved      Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  tableNumber     Int?
  createdAt       DateTime @default(now())

  @@index([isApproved, createdAt])
  @@index([category])
}

model EventProgram {
  id          Int    @id @default(autoincrement())
  timeSlot    String
  title       String
  description String
  orderIndex  Int
}

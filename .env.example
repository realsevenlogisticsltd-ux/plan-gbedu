# Turso (production / Vercel)
DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Local development — SQLite file via libsql
# DATABASE_URL="file:./prisma/dev.db"

# OpenAI — optional. When unset, the AI pipeline falls back gracefully.
OPENAI_API_KEY=""

# Simple gate for /admin moderation dashboard
ADMIN_PASSWORD="change-me"

# Public base URL used for QR codes (defaults to window.location.origin)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
